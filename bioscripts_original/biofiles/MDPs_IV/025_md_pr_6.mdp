title               =  MD with PR
cpp                 =  /lib/cpp
define              =  -DPOSRES
constraints         =  all-bonds
integrator          =  md
tinit               =  540     ; ps !
dt                  =  0.002    ; ps !
nsteps              =  5000   ; total 10 ps ; 540ps-550ps;
nstcomm             =  1
nstxout             =  250
nstvout             =  1000
nstfout             =  0
nstlog              =  100
nstenergy           =  100
nstlist             =  10
ns_type             =  grid
; New values for ptase
coulombtype         =  PME
rlist               =  1.2
epsilon_rf          =  54
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
;
fourierspacing      =  0.12
fourier_nx          =  0
fourier_ny          =  0
fourier_nz          =  0
pme_order           =  4
ewald_rtol          =  1e-5
optimize_fft        =  yes
; Berendsen temperature coupling is on in three groups
Tcoupl              =  v-rescale
tc_grps             =  Protein Non-Protein
tau_t               =  0.1 0.1
ref_t               =  20 20
; Energy monitoring
energygrps          =  Protein Non-Protein
; Pressure coupling is not on
Pcoupl              =  parrinello-rahman
pcoupltype          =  isotropic
tau_p               =  2
compressibility     =  4.5e-5
ref_p               =  1.0
; Generate velocites is off at 20 K.
gen_vel             =  no
gen_temp            =  20.0
gen_seed            =  173529

