cpp                 =  /usr/bin/cpp
define              =  -DFLEXIBLE
constraints         =  none
integrator          =  steep
nsteps              =  10000
;
;	Energy minimizing stuff
;
emtol               =  10
emstep              =  0.001

nstcomm             =  1
ns_type             =  grid
; New values for ptase
coulombtype         =  PME
rlist               =  1.2
epsilon_rf          =  54
rcoulomb            =  1.2
vdwtype             =  cut-off
rvdw                =  1.2
;
Tcoupl              =  no
Pcoupl              =  no
gen_vel             =  no
